{
	"$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": ".",
		"outDir": "build/lua",
		"types": ["lua-types/5.1"]
	},
	"include": ["src"],
	"tstl": {
		"luaTarget": "5.1",
		"luaBundle": "eech-core.lua",
		"luaBundleEntry": "src/index.ts",
		"noImplicitSelf": true,
		"noHeader": false
	}
}
