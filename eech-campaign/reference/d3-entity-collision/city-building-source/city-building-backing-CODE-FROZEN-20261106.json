 "what_moved_to_the_host": [
  "the city building list (LIST_TYPE_CITY_BUILDING): its membership and ORDER (insertion at the head or after a predecessor; a scan walks head to tail), through the one funnel en_list.c; the scan's city traversal (mb_hostoffer.h, bound in en_cllsn.c) asks the host for the first building and the one after each; the campaign's list at the same place is only the conformance mirror (entity_scan.city_mirror, city_key, city_parent: named stops, never an end, a miss or a fallback)",
  "one canonical record per structure (eech-world roster.rs): a building's place in its city's list and its sector placement are declared the same entity (LINK, as soon as the second exists, in either order); the record is named by the legacy object-report identity at the point campaign_object_identify issues it (NAME, after the unchanged request and serial: lazy timing and the counter are unchanged, nothing is allocated earlier); a relink of a named structure names its new placement again (NAME, or the LINK to the child that still holds the record)",
  "ownership rules in the host: one placement of each kind per record; an identity names one record and ends with the record's last placement; a city's own sector placement cannot leave its list while a building is listed under it (the campaign destroys the buildings first, as ct_dstry asserts)"
 ],
 "what_remains_required": [
  "the tallest structure of a sector; every entity's shape, collision flags, live flags and static pose (the offer still reads them from the campaign's entities); hierarchy and sub-objects",
  "UPDATED and terrain-normal effectful services and the shared terrain record",
  "the other readers of the city list that still read the campaign's own list: the blast windows (explosn.c), cover (gd_cover.c), drawing (ct_draw.c), tacview; the campaign's list bookkeeping (LINK/UNLINK notifications) stays in EECH_DC",
  "raw tree/forest/cloud RNG, devices/muzzles/rotor/smoke, the DCS needed-only mapping, natural moving weapon, complete Task49 40/all8, CI, review and normal merge, all ten D3 requirements; D4/D5/TypeScript unstarted",
  "an object identity whose length leaves no room beside its key in the 128-byte identity place is a named stop (host-issued identities are far shorter): a stated limit, not a supported-path refusal"
 ],
 "complete_contract": {
  "traced_writers": {
   "creator": "cb_creat.c insert_local_entity_into_parents_child_list (en, LIST_TYPE_CITY_BUILDING, raw->city_building_link.parent, raw->city_building_link.child_pred) BEFORE the sector insertion; popread.c creates each city (ct_creat.c inserts it into its sector at the end of its creation) before its buildings, passes ENTITY_ATTR_PARENT (LIST_TYPE_CITY_BUILDING, city) and NO predecessor (no ENTITY_ATTR_CHILD_PRED names this list anywhere), so every building goes to the head and the walk order is newest first",
   "destroyers": "cb_dstry.c (sector delete first, then the city list delete, then set_free_entity); ct_dstry.c destroys the children through it before the city's own sector deletion (ASSERT first_child == NULL)",
   "unpack_restore": "no pack or unpack route carries the list: the city block of a session stores only the buildings' alive state and the list links are never packed; the buildings are created by popread before any unpack",
   "relink": "the sector relink of a fixed entity (fx_vec3d.c) deletes and inserts the SECTOR list only; the city list is not touched",
   "release_reset": "place_release_entity removes a still-listed building (city list first, then the sector placement) from the keys recorded at the insertion; a boot (place_reset) clears the campaign's keys and the host's roster, lists and records"
  },
  "wire": "ENTITY_SCAN question, phases 7 CHILD_INSERT (identity: parent key, or parent key and predecessor key; the entity type in fact 3), 8 CHILD_REMOVE (parent and child), 9 CHILD_FIRST (parent), 10 CHILD_NEXT (parent and child), 11 LINK (sector placement and child), 12 NAME (placement key, one space, the object identity); every other fact zero; replies: next (first/next building, empty at the end), placed (the key issued, or the key linked/named echoed), removed; the FFI, engine and dc layers are unchanged (the existing states carry them)",
  "validation_order": "C: the identity place grammar (keys, count, object identity text, 128-byte field) before anything is sent; host: every word by integer classification (no FP), then every key against the live roster and its parent relation BEFORE anything is served or changed; the standing-key rules of ENTRY and RESOLVED are unchanged; the reply is checked completely in C (state per phase, key rules, echoes, no cursor)",
  "preserved": "city and child first-found order (host list head first, mirror-compared), city-level versus child exclusions and windows/depth/cursors (the kernel and the candidate dialogue are unchanged), parent/child construction order (the parent's sector placement is required and named when absent), the lazy object-identity timing and counter, no RNG, FPU state, or pointer/layout exposure, and one record per entity (no second store)"
 },
 "distinguishing_backing_dependence_control": {
  "specified_before_implementation": true,
  "mode": "withdrawn_child (entity-authority.lua, test-only; the same pattern as the closed withdrawn_backing)",
  "behaviour": "at the first real city traversal reply that serves a building, the driver sends the host's own REMOVE of that building (phase 8, the city's key and the building's) to the SAME real provider, requires `removed`, hands the reply on unchanged (the campaign's lists, the building and its physics are untouched), counts the withdrawal apart; the traversal's next question stands at the ended building and the provider refuses it by name",
  "credit": "marker entity_scan.refused AND the withdrawal acknowledged AND the question after it was child_next AND the failure line names '[roster.child]' and 'has ended' AND request_faults 0 AND the only reply fault the host's refusal; never an arbitrary exit; reported safely as city_withdrawn, city_withdrawn_next, city_withdrawn_cause (no key, entity or physical data)",
  "old_core_backed_cannot_pass": "an old Core-backed traversal asks the host no city question: city_served is 0 and the mode returns UNREACHED ('the case holds no city traversal'); the same flight shape is the negative test that is green here. Generic scan_none/withheld modes override above the lookup and prove no new backing.",
  "native_prerequisite": "the default fixed case may hold no city whose box the scan meets: then the driver reports the finite prerequisite UNREACHED with the city counts; no actor, time or geometry hunt, no guessed result, and no criterion was weakened. Root runs one matched healthy control (reports city_*) and the specific mode after the source review."
 },
 "new_proof_plan_for_root": [
