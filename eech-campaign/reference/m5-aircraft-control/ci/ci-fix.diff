diff --git a/.github/workflows/eech-campaign.yml b/.github/workflows/eech-campaign.yml
index 1d08df13..dbd2726f 100644
--- a/.github/workflows/eech-campaign.yml
+++ b/.github/workflows/eech-campaign.yml
@@ -135,6 +135,12 @@ jobs:
       - uses: actions/checkout@v4
       - name: Toolchain
         run: |
+          # The runner's apt mirror list (mirror+file:/etc/apt/apt-mirrors.txt)
+          # resolves to azure.archive.ubuntu.com, whose package downloads stalled
+          # past the job timeout. Point only those entries at the canonical HTTPS
+          # archive; other sources, suites and signature checks are unchanged.
+          sudo find /etc/apt -maxdepth 2 -type f \( -name sources.list -o -name '*.sources' -o -name '*.list' \) \
+            -exec sed -i -E 's#(mirror\+file:/etc/apt/apt-mirrors\.txt|https?://azure\.archive\.ubuntu\.com/ubuntu/?)#https://archive.ubuntu.com/ubuntu#g' {} +
           sudo apt-get update
           sudo apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 wine wine64
           sudo update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix
